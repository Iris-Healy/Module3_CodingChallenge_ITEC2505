@page
@model IndexModel
@{
    ViewData["Title"] = "Zoo Visitors App";
}
<!-- header for the page --> </>
<h1>Welcome to the Zoo Visitors App</h1>
<!-- form that collects hungerLevel and dayOfWeek from user -->
<form method="post">
    
    <label>Enter the animal's hunger level (1-10):</label>
    <input type="number" id="hungerLevel" name="hungerLevel", min="1", and max="10" />
    
    <br><br>
    
    <label> Enter the day of the week (1-7, where 1 is Sunday) </label>
    <input type="number", name="dayOfWeek", min="1", and max="7" />
    
    <br><br>
    
    <button type="submit"> Submit </button>
</form>
<!-- if statement checking if user has inputted into the form displays the messages -->
@if(Model.HungerMessage != "")
{
    <p>@Model.HungerMessage</p>
    <p>@Model.SoundMessage</p>
    <p>The message of the day is @Model.DayMessage</p>
}